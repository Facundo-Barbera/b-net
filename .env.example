# Copia a .env en la máquina donde corra (bixku-homelab). Nunca subas .env al repo.
# Todos los valores son PLACEHOLDERS.

# --- Hub ---
HUB_LISTEN_HOST=100.64.0.10          # IP de Tailscale de bixku-homelab (no 0.0.0.0)
HUB_LISTEN_PORT=8780
HUB_DATA_DIR=/var/lib/bixku-hub

# Beszel (PocketBase). Usuario de solo lectura creado para el hub.
BESZEL_URL=http://127.0.0.1:8090
BESZEL_EMAIL=hub-readonly@example.invalid
BESZEL_PASSWORD=__CHANGE_ME__

# Tailscale: "cli" (tailscale status --json) o "localapi" (socket de tailscaled)
TAILSCALE_SOURCE=localapi
TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock

# T3: endpoints de los exportadores por máquina (agente bixku), separados por coma
T3_EXPORTERS=http://bixku-vps:8781,http://bixku-focaltec:8781

# --- Proxy ---
PROXY_LISTEN_HOST=100.64.0.10
PROXY_LISTEN_PORT=8318               # distinto al de CLIProxyAPI para convivir durante la migración
# Llave maestra para descifrar el secret store (mejor: systemd-creds / LoadCredential)
PROXY_SECRETS_FILE=/var/lib/bixku-proxy/secrets.enc
PROXY_MASTER_KEY_FILE=/run/credentials/bixku-proxy.service/master-key

# --- Agente opcional ---
AGENT_LISTEN_HOST=100.64.0.11
AGENT_LISTEN_PORT=8781
AGENT_T3_DB=/home/USER/.t3/userdata/statev2.sqlite
