# Variables EXTRA del hub (complementan .env.example). Todos los valores son PLACEHOLDERS.
# Los secretos se leen preferentemente de *_FILE (systemd LoadCredential); la variable directa es fallback.

HUB_MACHINE_ID=bixku-homelab                     # centro del mapa; por defecto la máquina con role "hub"
HUB_MACHINES_FILE=config/machines.json           # validado con MachineConfig
HUB_WEB_DIR=                                     # vacío = packages/web/dist/app (si existe index.html)
HUB_POLL_FAST_SEC=15                             # Tailscale, Beszel, proxy (+ ingesta de usage records)
HUB_POLL_AGENT_SEC=30                            # agentes pull: /agent/v1/metrics y /agent/v1/t3/threads; ×3 = frescura de las métricas push (90 s)

# Token opcional para /api/* (Authorization: Bearer ...). Vacío = sin auth (solo bind en Tailscale).
HUB_API_TOKEN_FILE=/run/credentials/b-net.service/api-token

# Proxy interno (ProxyInternalRoutes). Sin HUB_PROXY_URL el hub no consulta el proxy.
HUB_PROXY_URL=http://100.64.0.10:8318
HUB_PROXY_TOKEN_FILE=/run/credentials/b-net.service/proxy-admin-token

# Proyectos y entregables (necesitan HUB_DATA_DIR de .env.example): metadatos en <HUB_DATA_DIR>/hub.sqlite,
# archivos en <HUB_DATA_DIR>/deliverables (máx. 1 GiB por entregable).
HUB_DELIVERABLES_QUOTA_GB=100                    # tope total; al pasarlo las subidas responden 507
# Tokens de escritura por bot, solo hashes (formato: config/bot-tokens.example.json). Fuera del repo.
# Generar uno: node packages/hub/scripts/bot-token.ts <bot>. Sin archivo = nadie puede escribir.
HUB_BOT_TOKENS_FILE=/etc/b-net/bot-tokens.json

# Métricas empujadas por los agentes (POST /ingest/v1/metrics): un token por máquina, solo se guarda su hash
# en $HUB_DATA_DIR/hub.sqlite. Sin HUB_DATA_DIR no hay tokens y la ingesta responde 401.
#   HUB_DATA_DIR=/var/lib/b-net node packages/hub/scripts/agent-token.ts issue <machine-id>

# Token común hub -> agentes en modo pull (solo el exportador T3 opcional, src/serve.ts)
HUB_AGENT_TOKEN_FILE=/run/credentials/b-net.service/agent-token

# Beszel: mejor por archivo que por env
BESZEL_PASSWORD_FILE=/run/credentials/b-net.service/beszel-password

# Solo si TAILSCALE_SOURCE=cli
TAILSCALE_BIN=tailscale

# --- Board (@vercel/board 0.52.0, dentro del hub en /api/board) ---
# Sin HUB_BOARD_URL no hay board. Necesita HUB_DATA_DIR: el board guarda su SQLite en <HUB_DATA_DIR>/board,
# y los tokens de bots, el outbox de webhooks y el cursor de eventos en <HUB_DATA_DIR>/hub.sqlite.
HUB_BOARD_URL=https://bixku-homelab.tail0fake.ts.net/api/board   # el nombre que imprime `tailscale serve`
# Admins (logins de Tailscale), bots, proyectos por bot y webhooks (formato: config/board.example.json). Fuera del repo.
HUB_BOARD_CONFIG_FILE=/etc/b-net/board.json
# Puerto en 127.0.0.1 al que apunta `tailscale serve`: el único por el que se confía Tailscale-User-Login.
HUB_SERVE_PORT=8779
# Destino de los eventos de un bot sin webhook propio: el receptor de prueba local (scripts/webhook-sink.ts).
HUB_WEBHOOK_DEFAULT_URL=http://127.0.0.1:8799/bnet-webhook
# Tokens de bots para el board (solo se guarda su hash; se imprime una vez):
#   HUB_DATA_DIR=/var/lib/b-net HUB_BOARD_CONFIG_FILE=/etc/b-net/board.json node packages/hub/scripts/board-token.ts issue <bot>
