{
  "name": "@b-net/agent",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@b-net/core": "workspace:*"
  },
  "scripts": {
    "push": "node --disable-warning=ExperimentalWarning src/push.ts",
    "start": "node --disable-warning=ExperimentalWarning src/serve.ts",
    "build:bin": "bun build src/push.ts --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/b-net-agent",
    "measure": "node scripts/measure.ts"
  }
}
